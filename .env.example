# Copiar a .env únicamente si todavía no existe ese archivo.
# Clave para los embeddings y las respuestas del asistente RAG.
OPENAI_API_KEY=

# Modelos del RAG de referencia y umbral de similitud para generar respuestas.
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_UMBRAL=0.60
RAG_TOP_K=8

# Rellenar si la conexión de red requiere proxy.
HTTPS_PROXY=

# Ubicación prevista para la base de datos local.
DATABASE_PATH=data/agora.sqlite3
